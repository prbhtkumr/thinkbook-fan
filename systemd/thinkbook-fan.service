[Unit]
Description=ThinkBook fan curve service
After=multi-user.target systemd-modules-load.service

[Service]
Type=simple
TimeoutStopSec=10
RuntimeDirectory=thinkbook-fan
RuntimeDirectoryMode=2775
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
UMask=0027
ExecStartPre=-/sbin/modprobe thinkpad_acpi
ExecStart=/usr/local/bin/thinkbook-fan run --config /etc/thinkbook-fan/config.toml
ExecStopPost=-/usr/bin/timeout 5 /bin/sh -c 'echo "watchdog 0" > /proc/acpi/ibm/fan; echo "level auto" > /proc/acpi/ibm/fan'
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
